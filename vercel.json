{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "redirects": [
    { "source": "/(.*)", "has": [{ "type": "host", "value": "hoyodex.com" }], "destination": "https://www.hoyodex.com/$1", "permanent": true },
    { "source": "/youtube", "destination": "https://youtube.com/@hoyodex", "permanent": false },
    { "source": "/instagram", "destination": "https://instagram.com/hoyodex", "permanent": false },
    { "source": "/twitter", "destination": "https://x.com/hoyodex_", "permanent": false },
    { "source": "/x", "destination": "https://x.com/hoyodex_", "permanent": false },
    { "source": "/linkedin", "destination": "https://linkedin.com/company/hoyodex", "permanent": false },
    { "source": "/tiktok", "destination": "https://tiktok.com/@hoyodex", "permanent": false }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        { "key": "X-Frame-Options", "value": "DENY" },
        { "key": "Cross-Origin-Opener-Policy", "value": "same-origin" },
        { "key": "Permissions-Policy", "value": "geolocation=(), camera=(), microphone=(), payment=(), usb=(), interest-cohort=()" },
        { "key": "Strict-Transport-Security", "value": "max-age=31536000; includeSubDomains; preload" },
        { "key": "Content-Security-Policy", "value": "default-src 'self'; img-src 'self' data: https://static.wikia.nocookie.net https://vignette.wikia.nocookie.net https://genshin-impact.fandom.com https://honkai-star-rail.fandom.com https://zenless-zone-zero.fandom.com https://tearsofthemis.fandom.com; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; script-src 'self' 'unsafe-inline'; connect-src 'self'; frame-ancestors 'none'; base-uri 'self'; form-action 'self'; object-src 'none'" }
      ]
    },
    {
      "source": "/_astro/(.*)",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }]
    }
  ]
}
