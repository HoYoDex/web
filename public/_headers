# Security headers for every response.
# Cloudflare's Astro adapter appends its own immutable-caching rules for
# /_astro/* to this file at build time — don't duplicate those here.
/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  X-Frame-Options: DENY
  Cross-Origin-Opener-Policy: same-origin
  Permissions-Policy: geolocation=(), camera=(), microphone=(), payment=(), usb=(), interest-cohort=()
  Strict-Transport-Security: max-age=31536000; includeSubDomains; preload
  # Article images are hotlinked from the wiki's CDN; fonts come from Google.
  #
  # script-src needs 'unsafe-inline': Astro emits small inline bootstrap scripts
  # for island hydration and viewport prefetching. Nonces would need a server
  # rendering each response, and this site is static; hashes would change on
  # every build. The remaining directives still block the things that matter —
  # external script origins, framing, plugins and base-tag injection.
  Content-Security-Policy: default-src 'self'; img-src 'self' data: https://static.wikitide.net https://static.miraheze.org https://hoyodex.miraheze.org; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; script-src 'self' 'unsafe-inline'; connect-src 'self'; frame-ancestors 'none'; base-uri 'self'; form-action 'self'; object-src 'none'
