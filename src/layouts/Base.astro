---
import '../styles/global.css';

import type { Game } from '../lib/games';
import NavDropdown from '../components/NavDropdown.astro';

interface Props {
  title: string;
  description?: string;
  sourceUrl?: string;
  wide?: boolean;
  game?: Game;
}

const {
  title,
  description = 'HoYoDex — the open, community-run index of every HoYoverse game.',
  sourceUrl,
  wide = false,
  game,
} = Astro.props;

const fullTitle = title === 'HoYoDex' ? title : `${title} · HoYoDex`;
const canonical = new URL(Astro.url.pathname, Astro.site);

const navLinks = [
  { href: '/', icon: '<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 12l2-2m0 0l7-7 7 7M5 10v10a1 1 0 001 1h3m10-11l2 2m-2-2v10a1 1 0 01-1 1h-3m-6 0a1 1 0 001-1v-4a1 1 0 011-1h2a1 1 0 011 1v4a1 1 0 001 1m-6 0h6" />', label: 'Home' },
  { href: '/games', icon: '<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 10l-2 1m0 0l-2-1m2 1v2.5M20 7l-2 1m2-1l-2-1m2 1v2.5M14 4l-2-1-2 1M4 7l2-1M4 7l2 1M4 7v2.5M12 21l-2-1m2 1l2-1m-2 1v-2.5M6 18l-2-1v-2.5M18 18l2-1v-2.5" />', label: 'Games' },
  { href: '/search', icon: '<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" />', label: 'Search' },
];
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" href="/favicon.ico" sizes="48x48" />
    <link rel="icon" href="/logo-mark.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/logo-mark-180.png" />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={new URL('/og-image.png', Astro.site)} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:site" content="@hoyodex_" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Rajdhani:wght@500;600;700&family=Inter:wght@400;500;600&display=swap"
    />
  </head>

  <body class="field flex min-h-screen bg-void-950 font-sans text-zinc-300">
    <a href="#main" class="sr-only focus:not-sr-only focus:absolute focus:z-50 focus:m-3 focus:rounded focus:bg-astral-500 focus:px-4 focus:py-2 focus:text-void-950">Skip to content</a>

    {/* GLOBAL LEFT SIDEBAR (The Rail) */}
    <aside class="fixed inset-y-0 left-0 z-50 flex w-16 flex-col items-center border-r border-void-700 bg-void-900 py-4 shadow-xl">
      <a href="/" class="group mb-8 flex h-10 w-10 items-center justify-center rounded-xl bg-void-800 transition-colors hover:bg-void-700">
        <img src="/logo-mark.svg" alt="HoYoDex" class="h-6 w-6 transition-transform duration-300 group-hover:rotate-[30deg]" />
      </a>
      <nav class="flex flex-col gap-4">
        {navLinks.map(link => (
          <a href={link.href} title={link.label} class:list={["flex h-10 w-10 items-center justify-center rounded-xl transition-colors hover:bg-void-700 hover:text-zinc-100", Astro.url.pathname === link.href || (link.href !== '/' && Astro.url.pathname.startsWith(link.href)) ? "bg-void-800 text-astral-400" : "text-zinc-500"]}>
            <svg class="h-5 w-5" fill="none" stroke="currentColor" viewBox="0 0 24 24" set:html={link.icon}></svg>
          </a>
        ))}
      </nav>
      <div class="mt-auto">
        <a href="https://github.com/HoYoDex/web" title="GitHub" rel="noopener" class="flex h-10 w-10 items-center justify-center rounded-xl text-zinc-500 transition-colors hover:bg-void-800 hover:text-zinc-100">
          <svg class="h-5 w-5" fill="currentColor" viewBox="0 0 24 24"><path fill-rule="evenodd" clip-rule="evenodd" d="M12 2C6.477 2 2 6.484 2 12.017c0 4.425 2.865 8.18 6.839 9.504.5.092.682-.217.682-.483 0-.237-.008-.868-.013-1.703-2.782.605-3.369-1.343-3.369-1.343-.454-1.158-1.11-1.466-1.11-1.466-.908-.62.069-.608.069-.608 1.003.07 1.531 1.032 1.531 1.032.892 1.53 2.341 1.088 2.91.832.092-.647.35-1.088.636-1.338-2.22-.253-4.555-1.113-4.555-4.951 0-1.093.39-1.988 1.029-2.688-.103-.253-.446-1.272.098-2.65 0 0 .84-.27 2.75 1.026A9.564 9.564 0 0112 6.844c.85.004 1.705.115 2.504.337 1.909-1.296 2.747-1.027 2.747-1.027.546 1.379.202 2.398.1 2.651.64.7 1.028 1.595 1.028 2.688 0 3.848-2.339 4.695-4.566 4.943.359.309.678.92.678 1.855 0 1.338-.012 2.419-.012 2.747 0 .268.18.58.688.482A10.019 10.019 0 0022 12.017C22 6.484 17.522 2 12 2z"/></svg>
        </a>
      </div>
    </aside>

    <div class="flex min-w-0 flex-1 flex-col pl-16">
      {/* HEADER AREA */}
      {game ? (
        <header class="relative border-b border-void-700 bg-void-900 shadow-md z-40">
          <div class="absolute inset-0 z-0 overflow-hidden opacity-30">
            <div class="absolute inset-0 bg-gradient-to-r from-void-900 via-void-900/80 to-transparent"></div>
            <div class="h-full w-full bg-gradient-to-b from-transparent to-void-900" style={`background-image: radial-gradient(circle at 100% 0%, ${game.accent}40 0%, transparent 60%);`}></div>
          </div>
          <div class="relative z-10 mx-auto px-6 pt-8 pb-0" class:list={[wide ? "max-w-[100rem]" : "max-w-6xl"]}>
            <div class="mb-4 flex items-end justify-between">
              <div>
                <a href={`/games/${game.slug}`} class="font-display text-4xl font-bold tracking-tight text-white drop-shadow-md">{game.name} Wiki</a>
                <div class="mt-1 flex items-center gap-3 text-xs font-semibold uppercase tracking-wider text-zinc-400">
                  <a href={`/search?q=&game=${game.slug}`} class="flex items-center gap-1 hover:text-zinc-200">
                    <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 11H5m14 0a2 2 0 012 2v6a2 2 0 01-2 2H5a2 2 0 01-2-2v-6a2 2 0 012-2m14 0V9a2 2 0 00-2-2M5 11V9a2 2 0 012-2m0 0V5a2 2 0 012-2h6a2 2 0 012 2v2M7 7h10"/></svg>
                    Explore
                  </a>
                </div>
              </div>
            </div>

            {/* HORIZONTAL NAVBAR WITH DROPDOWNS */}
            <nav class="flex items-center gap-1">
              <a href={`/games/${game.slug}`} class="border-b-2 border-transparent px-3 py-3 text-sm font-semibold text-zinc-300 transition-colors hover:text-white hover:border-astral-400">Home</a>
              {game.nav?.map(menu => (
                <div class="group relative">
                  <button class="flex items-center gap-1 border-b-2 border-transparent px-3 py-3 text-sm font-semibold text-zinc-300 transition-colors group-hover:border-astral-400 group-hover:text-white">
                    {menu.label}
                    <svg class="h-3 w-3 transition-transform group-hover:rotate-180" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"/></svg>
                  </button>
                  <div class="pointer-events-none absolute left-0 top-full z-50 mt-0 w-48 -translate-y-2 opacity-0 shadow-xl transition-all group-hover:pointer-events-auto group-hover:translate-y-0 group-hover:opacity-100">
                    <NavDropdown items={menu.items || []} gameSlug={game.slug} />
                  </div>
                </div>
              ))}
            </nav>
          </div>
        </header>
      ) : (
        <header class="sticky top-0 z-40 border-b border-void-700/80 bg-void-950/70 backdrop-blur-xl px-6 py-4">
          <div class="mx-auto flex items-center justify-between" class:list={[wide ? "max-w-[100rem]" : "max-w-6xl"]}>
            <a href="/" class="font-display text-xl font-bold tracking-tight text-zinc-100">
              HoYo<span class="bg-gradient-to-r from-astral-400 to-nova-400 bg-clip-text text-transparent">Dex</span>
            </a>
          </div>
        </header>
      )}

      <main id="main" class:list={["mx-auto w-full flex-1 px-6 py-8", wide ? "max-w-[100rem]" : "max-w-6xl"]}><slot /></main>

      <footer class="mt-auto border-t border-void-700/80 bg-void-900/40 px-6 py-10 backdrop-blur">
        <div class="mx-auto max-w-6xl">
          <div class="mb-6 flex items-center gap-2.5 font-display text-lg font-bold text-zinc-300">
            <img src="/logo-mark.svg" alt="" width="24" height="24" />
            HoYoDex
          </div>
        <div class="space-y-3 text-sm text-zinc-500">
          {sourceUrl && (
            <p>
              This page adapts content from the
              <a class="text-astral-400 underline" href={sourceUrl} rel="noopener">HoYoverse Universe Index</a>,
              available under <a class="text-astral-400 underline" href="https://creativecommons.org/licenses/by-sa/4.0/" rel="noopener">CC BY-SA 4.0</a>.
            </p>
          )}
          <p>
            Site code licensed <a class="text-astral-400 underline" href="https://github.com/HoYoDex/web/blob/main/LICENSE" rel="noopener">AGPL-3.0-or-later</a>. Wiki content under CC BY-SA 4.0.
          </p>
          <p>
            HoYoDex is a fan project. Not affiliated with, endorsed by, or sponsored by COGNOSPHERE PTE. LTD., miHoYo, or HoYoverse.
          </p>
        </div>
        </div>
      </footer>
    </div>
  </body>
</html>
