---
import Base from '../../layouts/Base.astro';
import { getCollection, getEntry } from 'astro:content';
import { GAMES } from '../../lib/games';
import { fetchLiveNavigation } from '../../lib/navParser';
import { getCachedPage, setCachedPage, getCachedNav, setCachedNav, safeWaitUntil } from '../../lib/pageCache';

export const prerender = false;

export async function getStaticPaths() {
  const pages = await getCollection('wiki');
  return pages.map((page) => ({ params: { slug: page.id } }));
}

import { MediaWikiClient, rewriteHtml } from '../../lib/mediawiki';

const { slug } = Astro.params;
const page = await getEntry('wiki', slug!);

// The slug is always `${gameSlug}/${toSlug(title)}`, so the game is always
// resolvable even when the page itself isn't in the build-time index yet
// (e.g. it was created upstream since the last build).
const gameSlug = page?.data.game ?? slug!.split('/')[0];
const game = GAMES.find((g) => g.slug === gameSlug);
if (!game) return Astro.redirect('/404');

const client = new MediaWikiClient({ endpoint: game.endpoint, userAgent: 'HoYoDexBot/0.1 (https://www.hoyodex.com; tech@hoyodex.com)' });

// Nav tree: durable cache first (survives across edges/regions/deploys,
// unlike relying on the function staying warm), live fetch only on a miss
// or when the cached copy has aged past NAV_FRESH — served stale
// immediately either way, refreshed in the background.
const cachedNav = await getCachedNav(game.slug);
let liveNav = (cachedNav?.nav as Awaited<ReturnType<typeof fetchLiveNavigation>>) ?? undefined;
if (!liveNav) {
  liveNav = await fetchLiveNavigation(game.slug);
  safeWaitUntil(setCachedNav(game.slug, liveNav));
} else if (!cachedNav!.fresh) {
  safeWaitUntil(fetchLiveNavigation(game.slug).then((fresh) => setCachedNav(game.slug, fresh)));
}

// Article content: same durable-cache-first pattern. A known page's HTML
// rarely changes, so most requests should never have to touch Fandom at
// all — the cache is keyed by our own slug, which is stable regardless of
// whether the title came from the build-time collection or a live search.
const cached = await getCachedPage(slug!);

let displayTitle: string;
let html: string;
let categories: string[];
let toc: { level: number; line: string; anchor: string }[];
let updated: string;
let sourceUrl: string;

async function fetchAndCache(resolvedTitle: string) {
  const parsed = await client.parsePage(resolvedTitle);
  const rewritten = rewriteHtml(parsed.html, game!.endpoint, game!.slug);
  const result = {
    displayTitle: page?.data.displayTitle ?? parsed.displaytitle,
    html: rewritten,
    categories: parsed.categories,
    sections: parsed.sections.filter((s: any) => s.level <= 3),
    sourceUrl: page?.data.sourceUrl ?? `${game!.endpoint}/wiki/${encodeURIComponent(resolvedTitle.replace(/ /g, '_'))}`,
    updated: page?.data.updated ?? new Date().toISOString(),
  };
  await setCachedPage(slug!, result);
  return result;
}

if (cached) {
  ({ displayTitle, html, categories, sections: toc, sourceUrl, updated } = cached.page);
  if (!cached.fresh) {
    // Serve the stale copy now; refresh it for the next visitor without
    // making this one wait on a live Fandom round-trip.
    const title = page?.data.title ?? cached.page.displayTitle;
    safeWaitUntil(fetchAndCache(title).catch(() => {}));
  }
} else {
  let title = page?.data.title;
  if (!title) {
    // Collection miss: `toSlug` is lossy, so we can't reconstruct the exact
    // title from the URL slug — resolve it via a cheap, Fandom-cached search
    // instead, then render exactly like a known page.
    const guess = slug!.slice(gameSlug.length + 1).replace(/-/g, ' ');
    title = (await client.searchTitle(guess)) ?? undefined;
    if (!title) return Astro.redirect('/404');
  }
  ({ displayTitle, html, categories, sections: toc, sourceUrl, updated } = await fetchAndCache(title));
}

// Still worth a short edge-cache layer in front of the durable cache — a
// burst of concurrent requests for the same brand-new page shouldn't all
// miss Redis at once.
Astro.response.headers.set('Cache-Control', 'public, max-age=300, stale-while-revalidate=86400');
---

<Base title={displayTitle} description={`${displayTitle} — HoYoDex`} sourceUrl={sourceUrl} wide={true} game={game} nav={liveNav}>
  <div class="flex flex-col gap-8 xl:flex-row xl:items-start">
    {/* MAIN CONTENT */}
    <article class="min-w-0 flex-1 rounded-2xl border border-void-700 bg-void-900/40 p-6 backdrop-blur-sm sm:p-10 shadow-2xl shadow-void-950/50">
      <h1 class="font-display text-4xl font-bold tracking-tight sm:text-5xl">{displayTitle}</h1>
      <p class="mt-3 text-sm text-zinc-500">Last updated {updated.slice(0, 10)}</p>
      
      <div class="wiki-body mt-8" set:html={html}></div>

      {categories.length > 0 && (
        <footer class="mt-12 rounded-xl border border-void-700 bg-void-850 p-6">
          <h2 class="mb-3 text-xs font-semibold uppercase tracking-wider text-zinc-500">Categories</h2>
          <ul class="flex flex-wrap gap-2">
            {categories.map((c: any) => (
              <li class="rounded-full border border-void-600 bg-void-900 px-3 py-1 text-xs font-medium text-zinc-400 shadow-sm transition-colors hover:border-void-500 hover:text-zinc-200">
                <a href={`/search?q=${encodeURIComponent(c)}&game=${game?.slug}`}>{c}</a>
              </li>
            ))}
          </ul>
        </footer>
      )}
    </article>

    {/* RIGHT SIDEBAR: Table of Contents */}
    {toc.length > 0 && (
      <aside class="hidden w-72 shrink-0 xl:block">
        <div class="sticky top-24 rounded-xl border border-void-700 bg-void-850/50 p-5 backdrop-blur-md">
          <h2 class="mb-3 font-display text-xs font-semibold uppercase tracking-wider text-zinc-500">Contents</h2>
          <ul class="space-y-1.5 border-l border-void-700 text-sm">
            {toc.map((s: any) => (
              <li>
                <a href={`#${s.anchor}`}
                   class="block border-l-2 border-transparent py-0.5 text-zinc-400 transition-colors hover:border-astral-400 hover:text-zinc-100"
                   style={`padding-left:${(s.level - 1) * 0.7 + 0.7}rem;margin-left:-1px`}>{s.line}</a>
              </li>
            ))}
          </ul>
        </div>
      </aside>
    )}
  </div>
</Base>
